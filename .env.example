PORT=3000

GITHUB_USERNAME='dantehemerson'
GITHUB_TOKEN=""

LASTFM_USERNAME="dantehemerson"
LASTFM_API_KEY=""

# Usage snapshots (SQLite) and OpenCode Go usage proxy
USAGE_DB_PATH='./data/usage.db'
OPENCODE_USAGE_API_KEY=""

# Collector authentication — first-party API tokens (primary).
# Generate a token with `npm run token:generate -- <label>`. It prints the
# plaintext token (goes in the collector's private config) and its SHA-256
# hash (goes here). Only the hash is stored, so a leaked environment does not
# grant write access. Each token is bound to exactly one mutation.
CHATGPT_USAGE_TOKEN_HASH=""
MACHINES_USAGE_TOKEN_HASH=""

# Collector authentication — Cloudflare Access service tokens (fallback).
# These identify the Access applications; neither value is a secret. Only
# needed while an Access application covers api.dantecalderon.com/graphql.
# The AUD values below are the OLD dash Access applications' tags and are
# placeholders — replace both with the new application's AUD tag. The client
# ids are unchanged: they identify the service tokens themselves.
# See docs/cloudflare-access-setup.md.
CHATGPT_USAGE_SYNC_AUD='a1a4c03f1338b531d3135e6913e35b825caccad371b0297c7941fa8eff686883'
CHATGPT_USAGE_SYNC_CLIENT_ID='309a932876a5bc7698196b162b53ec2a.access'
MACHINES_SYNC_AUD='fdc8b0d4a7cf390a1abf1ef1edb9e3e1fbbdc3653593599a043034da3254b2f7'
MACHINES_SYNC_CLIENT_ID='5f4605beb492b2c1887f2d6820fd7fe8.access'

# Optional cache TTLs in seconds
OPENCODE_USAGE_CACHE_TTL=60
USAGE_READ_CACHE_TTL=30
